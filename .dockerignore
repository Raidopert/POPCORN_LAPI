# =============================================================================
# .dockerignore — «Кошачий попкорнный Беспредел»
# Уменьшает контекст сборки и не тащит мусор в образ.
# Замечание: *.md (README, DOCKER.md, LICENSE и пр.) в игнор НЕ попадает —
# документацию можно свободно копировать в образ.
# =============================================================================

# --- зависимости и сборка (восстанавливаются внутри контейнера) ---
node_modules
.next
out
build

# --- git ---
.git
.gitignore
.gitattributes

# --- секреты (никогда не попадают в образ) ---
.env
.env.*
!.env.example

# --- локальные артефакты разработки ---
dev.log
*.log
tsconfig.tsbuildinfo
next-env.d.ts
start-windows.bat

# --- sqlite-артефакты локальных баз ---
db
*.db
*.sqlite
*.sqlite3
prisma/*.db

# --- служебные каталоги песочницы/инструментов ---
tool-results
agent-ctx
skills
upload

# --- docker-файлы (в образ не копируются; docker-entrypoint.sh НЕ игнорируем!) ---
Dockerfile
docker-compose.yml

# --- деплой/система ---
.vercel
.DS_Store
Thumbs.db
